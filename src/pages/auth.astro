---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In" activeStep={1}>

  <a href="/" class="back-link">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
    BACK
  </a>

  <div class="auth-page">
    <div class="auth-left">
      <div class="auth-heading">
        <span class="auth-h-sign">SIGN IN</span>
        <span class="auth-h-create">OR CREATE</span>
        <span class="auth-h-account">AN ACCOUNT</span>
      </div>

      <div class="auth-form" style="padding: 24px 20px;">
        <div id="auth-error" class="alert alert-error" style="display:none"></div>

        <button class="btn-google" id="google-btn">
          <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          CONTINUE WITH GOOGLE
        </button>

      </div>
    </div>

    <div class="auth-right">
      <div class="cup-container" style="transform: translateX(-15%);">
        <img src="/images/cup.png" alt="Coffee cup" class="cup-img" style="width:clamp(280px,30vw,460px);" />
      </div>
      <div class="step-number-bg" style="bottom: 80px; right: 40px;">01</div>
    </div>
  </div>

</Layout>

<style>
  .btn-google {
    width: 100%;
    padding: 14px 16px;
    background: #fff;
    border: 2px solid #111;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: .12em;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background .15s;
    color: #111;
  }
  .btn-google:hover { background: #f5f5f5; }

  @media (max-width: 768px) {
    .auth-page { grid-template-columns: 1fr !important; height: auto !important; overflow: visible !important; }
    .auth-right { display: none !important; }
    .auth-left { overflow: visible !important; border-right: none !important; }
    .auth-form { overflow-y: visible !important; max-height: none !important; }
    .auth-h-sign { font-size: 14vw !important; padding: 10px 20px !important; }
    .auth-h-create { font-size: 10vw !important; padding: 10px 20px !important; }
    .auth-h-account { font-size: 10vw !important; padding: 10px 20px !important; }
    .back-link { top: 62px !important; }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Si ya tiene sesión, redirigir directo
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) window.location.replace('/recipes');
  });

  document.getElementById('google-btn').addEventListener('click', async () => {
    const btn = document.getElementById('google-btn');
    btn.textContent = 'REDIRECTING...';
    btn.disabled = true;

    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        scopes: 'https://www.googleapis.com/auth/calendar',
        redirectTo: window.location.origin + '/recipes',
        queryParams: { access_type: 'offline', prompt: 'consent' },
      }
    });

    if (error) {
      const errorEl = document.getElementById('auth-error');
      errorEl.textContent = 'Error connecting with Google. Try again.';
      errorEl.style.display = 'block';
      btn.textContent = 'CONTINUE WITH GOOGLE';
      btn.disabled = false;
    }
  });
</script>