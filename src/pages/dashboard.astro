---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase.js';

const supabase = createSupabaseServerClient(Astro.request, Astro.response);
---

<Layout title="My Dashboard" activeStep={0} hideSteps={true}>

<style>
  .pc-steps, .pc-steps-mobile { display: none !important; }

  * { box-sizing: border-box; }

  .dash-page {
    min-height: calc(100vh - 56px);
    background: #fafaf8;
    padding: 40px;
    overflow-y: auto;
  }

  /* Header */
  .dash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 2px solid #111;
  }

  .dash-header-left { display: flex; align-items: center; gap: 16px; }

  .dash-avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    border: 2px solid #111;
    background: #e8c94a;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Black Han Sans', sans-serif;
    font-size: 20px; color: #111;
    flex-shrink: 0;
    overflow: hidden;
  }
  .dash-avatar img { width: 100%; height: 100%; object-fit: cover; }

  .dash-title {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 28px; color: #111; line-height: 1;
  }
  .dash-subtitle {
    font-family: 'Space Mono', monospace;
    font-size: 10px; color: #aaa; letter-spacing: .1em; margin-top: 4px;
  }

  .dash-header-right { display: flex; align-items: center; gap: 12px; }

  .dash-btn-primary {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 18px; background: #e8c94a; border: 2px solid #111;
    font-family: 'Space Mono', monospace; font-size: 10px;
    letter-spacing: .12em; font-weight: 700; color: #111;
    text-decoration: none; transition: background .15s; cursor: pointer;
    white-space: nowrap;
  }
  .dash-btn-primary:hover { background: #d4b535; }

  .dash-btn-ghost {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 18px; background: #fff; border: 2px solid #111;
    font-family: 'Space Mono', monospace; font-size: 10px;
    letter-spacing: .12em; font-weight: 700; color: #111;
    cursor: pointer; transition: background .15s; white-space: nowrap;
  }
  .dash-btn-ghost:hover { background: #f5f5f5; }

  .dash-btn-danger {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 18px; background: #fff; border: 2px solid #c94a35;
    font-family: 'Space Mono', monospace; font-size: 10px;
    letter-spacing: .12em; font-weight: 700; color: #c94a35;
    cursor: pointer; transition: background .15s; white-space: nowrap;
  }
  .dash-btn-danger:hover { background: #fff0ee; }

  /* Stats row */
  .dash-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  .dash-stat {
    background: #fff;
    border: 2px solid #111;
    padding: 20px 24px;
  }
  .dash-stat-value {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 36px; color: #111; line-height: 1;
    margin-bottom: 4px;
  }
  .dash-stat-label {
    font-family: 'Space Mono', monospace;
    font-size: 9px; color: #aaa; letter-spacing: .12em;
  }

  /* Table */
  .dash-table-wrap {
    background: #fff;
    border: 2px solid #111;
  }

  .dash-table-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 2px solid #111;
  }
  .dash-table-title {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 14px; color: #111; letter-spacing: .05em;
  }
  .dash-table-count {
    font-family: 'Space Mono', monospace;
    font-size: 9px; color: #aaa; letter-spacing: .1em;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead tr {
    border-bottom: 1px solid #e0ddd7;
    background: #f9f9f9;
  }

  th {
    font-family: 'Space Mono', monospace;
    font-size: 9px; letter-spacing: .15em; color: #aaa;
    padding: 10px 20px; text-align: left; font-weight: 400;
  }

  td {
    padding: 14px 20px;
    border-bottom: 1px solid #f0f0f0;
    vertical-align: middle;
  }

  tbody tr { transition: background .15s; }
  tbody tr:hover { background: #fafaf8; }
  tbody tr:last-child td { border-bottom: none; }

  .td-recipe {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 13px; color: #111;
  }

  .td-meta {
    font-family: 'Space Mono', monospace;
    font-size: 9px; color: #aaa; letter-spacing: .05em;
    margin-top: 2px;
  }

  .td-date {
    font-family: 'Space Mono', monospace;
    font-size: 10px; color: #111; letter-spacing: .05em;
  }

  .td-time {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 13px; color: #111;
  }

  .td-price {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 15px; color: #111;
  }

  .badge {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 9px; letter-spacing: .08em;
    padding: 3px 8px; border: 1px solid;
    white-space: nowrap;
  }
  .badge.confirmed { color: #2d7a3a; border-color: #2d7a3a; background: #f0fff4; }
  .badge.pending   { color: #b87a00; border-color: #b87a00; background: #fffbee; }
  .badge.cancelled { color: #c94a35; border-color: #c94a35; background: #fff0ee; }

  .meet-btn {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'Space Mono', monospace; font-size: 9px;
    letter-spacing: .08em; font-weight: 700;
    padding: 5px 10px; background: #111; color: #fff;
    text-decoration: none; border: none; cursor: pointer;
    transition: background .15s; white-space: nowrap;
  }
  .meet-btn:hover { background: #333; }

  .meet-pending {
    font-family: 'Space Mono', monospace;
    font-size: 9px; color: #ccc; letter-spacing: .05em;
  }

  /* Empty */
  .dash-empty {
    padding: 60px 20px;
    text-align: center;
    font-family: 'Space Mono', monospace;
    font-size: 11px; color: #aaa; letter-spacing: .08em; line-height: 2;
  }

  /* Skeleton */
  .dash-skeleton-row td {
    padding: 14px 20px;
  }
  .skel {
    height: 14px; border-radius: 2px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.2s infinite;
  }
  @keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

  #auth-checking {
    position: fixed; inset: 0; background: #fff; z-index: 999;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .15em; color: #aaa;
  }

  @media (max-width: 768px) {
    .dash-page { padding: 20px 16px; }
    .dash-stats { grid-template-columns: 1fr 1fr; }
    .dash-header { flex-direction: column; align-items: flex-start; gap: 16px; }
    .dash-header-right { flex-wrap: wrap; }
    .dash-table-wrap { overflow-x: auto; }
    th, td { padding: 10px 12px; }
  }
</style>

<div id="auth-checking">CHECKING SESSION...</div>

<div class="dash-page">

  <!-- Header -->
  <div class="dash-header">
    <div class="dash-header-left">
      <div class="dash-avatar" id="dash-avatar">?</div>
      <div>
        <div class="dash-title" id="dash-name">MY DASHBOARD</div>
        <div class="dash-subtitle" id="dash-email"></div>
      </div>
    </div>
    <div class="dash-header-right">
      <a href="/recipes" class="dash-btn-primary">
        + BOOK SESSION
      </a>
      <button id="logout-btn" class="dash-btn-danger">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
        SIGN OUT
      </button>
    </div>
  </div>

  <!-- Stats -->
  <div class="dash-stats">
    <div class="dash-stat">
      <div class="dash-stat-value" id="stat-total">—</div>
      <div class="dash-stat-label">TOTAL SESSIONS</div>
    </div>
    <div class="dash-stat">
      <div class="dash-stat-value" id="stat-confirmed">—</div>
      <div class="dash-stat-label">CONFIRMED</div>
    </div>
    <div class="dash-stat">
      <div class="dash-stat-value" id="stat-upcoming">—</div>
      <div class="dash-stat-label">UPCOMING</div>
    </div>
  </div>

  <!-- Table -->
  <div class="dash-table-wrap">
    <div class="dash-table-header">
      <span class="dash-table-title">MY BOOKINGS</span>
      <span class="dash-table-count" id="dash-count"></span>
    </div>
    <table>
      <thead>
        <tr>
          <th>RECIPE</th>
          <th>DATE</th>
          <th>TIME</th>
          <th>DURATION</th>
          <th>PRICE</th>
          <th>STATUS</th>
          <th>MEET</th>
        </tr>
      </thead>
      <tbody id="dash-tbody">
        <tr class="dash-skeleton-row">
          <td><div class="skel" style="width:120px"></div></td>
          <td><div class="skel" style="width:100px"></div></td>
          <td><div class="skel" style="width:60px"></div></td>
          <td><div class="skel" style="width:60px"></div></td>
          <td><div class="skel" style="width:50px"></div></td>
          <td><div class="skel" style="width:80px"></div></td>
          <td><div class="skel" style="width:90px"></div></td>
        </tr>
        <tr class="dash-skeleton-row">
          <td><div class="skel" style="width:140px"></div></td>
          <td><div class="skel" style="width:100px"></div></td>
          <td><div class="skel" style="width:60px"></div></td>
          <td><div class="skel" style="width:60px"></div></td>
          <td><div class="skel" style="width:50px"></div></td>
          <td><div class="skel" style="width:80px"></div></td>
          <td><div class="skel" style="width:90px"></div></td>
        </tr>
      </tbody>
    </table>
  </div>

</div>

</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) { window.location.replace('/auth'); return; }
    document.getElementById('auth-checking').style.display = 'none';
    loadDashboard(session);
  });

  document.getElementById('logout-btn').addEventListener('click', async () => {
    await supabase.auth.signOut();
    localStorage.removeItem('pc_max_step');
    localStorage.removeItem('pc_booking');
    window.location.replace('/auth');
  });

  async function loadDashboard(session) {
    const user = session.user;

    const name = user.user_metadata?.full_name ||
                 user.user_metadata?.name ||
                 user.email?.split('@')[0] || 'User';

    document.getElementById('dash-name').textContent = name.toUpperCase();
    document.getElementById('dash-email').textContent = user.email || '';

    if (user.user_metadata?.avatar_url) {
      document.getElementById('dash-avatar').innerHTML =
        `<img src="${user.user_metadata.avatar_url}" />`;
    } else {
      document.getElementById('dash-avatar').textContent = name.charAt(0).toUpperCase();
    }

    const { data: bookings, error } = await supabase
      .from('bookings')
      .select(`
        id, status, created_at,
        sessions (
          id, starts_at, duration, meet_link,
          recipes ( name, price )
        )
      `)
      .eq('user_id', user.id)
      .order('created_at', { ascending: false });

    const tbody = document.getElementById('dash-tbody');

    if (error || !bookings || bookings.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7">
            <div class="dash-empty">
              NO SESSIONS YET.<br/>
              BOOK YOUR FIRST COFFEE CLASS!
            </div>
          </td>
        </tr>
      `;
      document.getElementById('stat-total').textContent = '0';
      document.getElementById('stat-confirmed').textContent = '0';
      document.getElementById('stat-upcoming').textContent = '0';
      return;
    }

    const now = new Date();
    const confirmed = bookings.filter(b => b.status === 'confirmed').length;
    const upcoming  = bookings.filter(b => {
      const start = b.sessions?.starts_at ? new Date(b.sessions.starts_at) : null;
      return start && start > now;
    }).length;

    document.getElementById('stat-total').textContent = bookings.length;
    document.getElementById('stat-confirmed').textContent = confirmed;
    document.getElementById('stat-upcoming').textContent = upcoming;
    document.getElementById('dash-count').textContent = `${bookings.length} BOOKING${bookings.length !== 1 ? 'S' : ''}`;

    tbody.innerHTML = bookings.map(b => {
      const sess    = b.sessions;
      const recipe  = sess?.recipes;
      const startsAt = sess?.starts_at ? new Date(sess.starts_at) : null;

      const date = startsAt
        ? startsAt.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
        : '—';
      const time = startsAt
        ? startsAt.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })
        : '—';

      const statusClass = b.status === 'confirmed' ? 'confirmed'
                        : b.status === 'pending'   ? 'pending'
                        : 'cancelled';
      const meetLink = sess?.meet_link || '';

      return `
        <tr>
          <td>
            <div class="td-recipe">${recipe?.name || 'Coffee Session'}</div>
          </td>
          <td><div class="td-date">${date}</div></td>
          <td><div class="td-time">${time}</div></td>
          <td><span class="badge" style="color:#555;border-color:#e0ddd7;background:#f9f9f9;">${sess?.duration || 60} MIN</span></td>
          <td><div class="td-price">$${recipe?.price || '—'}</div></td>
          <td><span class="badge ${statusClass}">${b.status?.toUpperCase() || 'CONFIRMED'}</span></td>
          <td>
            ${meetLink
              ? `<a href="${meetLink}" target="_blank" class="meet-btn">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22 8l-6 4 6 4V8zM2 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
                  </svg>
                  JOIN MEET
                </a>`
              : `<span class="meet-pending">PENDING</span>`
            }
          </td>
        </tr>
      `;
    }).join('');
  }
</script>