---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Learn Coffee Recipes" activeStep={0}>

  <!-- DESKTOP: side by side -->
  <section class="pc-home-desktop">
    <div style="display:flex;flex-direction:column;flex-shrink:0;">
      <span style="font-family:'Black Han Sans',sans-serif;background:#5a7a9f;color:#fff;font-size:clamp(36px,6vw,110px);padding:clamp(10px,2vw,20px) clamp(20px,4vw,40px);line-height:1;display:block;">LEARN</span>
      <span style="font-family:'Black Han Sans',sans-serif;background:#e8c94a;color:#111;font-size:clamp(52px,10vw,180px);padding:clamp(12px,2.5vw,24px) clamp(24px,5vw,56px);line-height:1;display:block;margin-top:-2px;">COFFEE</span>
      <span style="font-family:'Black Han Sans',sans-serif;background:#c94a35;color:#fff;font-size:clamp(36px,6vw,110px);padding:clamp(10px,2vw,20px) clamp(20px,4vw,40px);line-height:1;display:block;margin-top:-2px;margin-left:clamp(24px,4vw,64px);">RECIPES</span>
    </div>
    <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:32px;">
      <img src="/images/cup.png" alt="Coffee cup" style="width:clamp(200px,28vw,460px);height:auto;object-fit:contain;" />
    </div>
  </section>

  <!-- MOBILE: full screen hero -->
  <section class="pc-home-mobile">
    <!-- Top half: text fills width -->
    <div style="flex:1;display:flex;flex-direction:column;justify-content:center;">
      <span style="font-family:'Black Han Sans',sans-serif;background:#5a7a9f;color:#fff;font-size:18vw;line-height:1;display:block;padding:3vw 6vw;">LEARN</span>
      <span style="font-family:'Black Han Sans',sans-serif;background:#e8c94a;color:#111;font-size:24vw;line-height:1;display:block;padding:4vw 6vw;margin-top:-1px;">COFFEE</span>
      <span style="font-family:'Black Han Sans',sans-serif;background:#c94a35;color:#fff;font-size:18vw;line-height:1;display:block;padding:3vw 6vw;margin-top:-1px;">RECIPES</span>
    </div>

    <!-- Bottom half: cup + CTA -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:24px 32px;border-top:2px solid #111;gap:16px;">
      <div>
        <p style="font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.12em;color:#666;margin-bottom:4px;">1:1 PRIVATE · 10 MIN · FROM $5</p>
        <a href="/recipes" style="display:inline-flex;align-items:center;gap:8px;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:#111;text-decoration:none;border-bottom:2px solid #111;padding-bottom:2px;font-weight:700;">
          START BREWING
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>
      <img src="/images/cup.png" alt="Coffee cup" style="width:30vw;max-width:140px;height:auto;object-fit:contain;" />
    </div>
  </section>

  <!-- Desktop START BREWING -->
  <a href="/recipes" class="pc-start-brewing-desktop" style="position:fixed;bottom:24px;right:24px;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:#111;text-decoration:none;display:flex;align-items:center;gap:8px;border-bottom:2px solid #111;padding-bottom:2px;z-index:30;">
    START BREWING
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>

</Layout>

<style>
  .pc-home-desktop {
    display: flex;
    align-items: center;
    min-height: calc(100vh - 56px);
    background: #fff;
  }
  .pc-home-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .pc-home-desktop { display: none; }
    .pc-home-mobile {
      display: flex;
      flex-direction: column;
      min-height: calc(100vh - 56px - 48px); /* minus bottom steps bar */
      background: #fff;
    }
    .pc-start-brewing-desktop { display: none !important; }
  }
</style>