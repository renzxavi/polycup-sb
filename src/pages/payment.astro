---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase.js';

const supabase = createSupabaseServerClient(Astro.request, Astro.response);
const status = Astro.url.searchParams.get('status') || '';
---

<Layout title="Complete Payment" activeStep={5}>

<style>
  .pc-steps, .pc-steps-mobile { display: none !important; }

  .pay-page {
    display: grid;
    grid-template-columns: 38% 62%;
    height: calc(100vh - 56px);
    overflow: hidden;
  }

  .pay-left {
    display: flex;
    flex-direction: column;
    border-right: 2px solid #111;
    overflow: hidden;
  }

  .pay-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    scrollbar-width: thin;
    scrollbar-color: #e0ddd7 transparent;
  }

  .pay-summary {
    border: 2px solid #111;
    margin-bottom: 20px;
  }
  .pay-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid #e0ddd7;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: .06em;
    color: #555;
  }
  .pay-summary-row:last-child { border-bottom: none; }
  .pay-summary-row strong {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 12px;
    color: #111;
  }
  .pay-summary-total {
    background: #f9f9f9;
    font-weight: 700;
    color: #111;
  }
  .pay-summary-total .pay-price {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 20px;
    color: #111;
  }

  .pay-alert {
    padding: 12px 16px;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: .08em;
    margin-bottom: 16px;
    border-left: 4px solid;
  }
  .pay-alert-success { background: #f0fff4; border-color: #2d7a3a; color: #2d7a3a; }
  .pay-alert-failure { background: #fff0ee; border-color: #c94a35; color: #c94a35; }
  .pay-alert-pending { background: #fffbee; border-color: #b87a00; color: #b87a00; }

  .pay-bottom {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-top: 2px solid #111;
  }

  .pay-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 16px; background: #009ee3; border: none;
    font-family: 'Space Mono', monospace; font-size: 12px;
    letter-spacing: .15em; font-weight: 700; color: #fff;
    cursor: pointer; transition: background .15s;
  }
  .pay-btn:hover { background: #007ab8; }
  .pay-btn:disabled { background: #e0ddd7; color: #aaa; cursor: not-allowed; }

  .pay-skip {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 10px 16px; background: none; border: none;
    border-top: 1px solid #e0ddd7;
    font-family: 'Space Mono', monospace; font-size: 10px;
    letter-spacing: .12em; color: #aaa;
    cursor: pointer; width: 100%; text-decoration: none;
    transition: background .15s;
  }
  .pay-skip:hover { background: #f9f9f9; color: #111; }

  .pay-logout {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: .12em;
    background: none; border: none; border-top: 1px solid #e0ddd7;
    color: #c94a35; cursor: pointer; width: 100%; text-align: left;
  }
  .pay-logout:hover { background: #fff0ee; }

  .pay-right {
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }

  .pay-cup { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); }
  .pay-cup img { width: clamp(280px, 30vw, 460px); height: auto; object-fit: contain; }

  .pay-watermark {
    position: absolute; bottom: 80px; right: 40px;
    font-family: 'Black Han Sans', sans-serif; font-size: 160px;
    color: #f0f0f0; line-height: 1; user-select: none; pointer-events: none;
  }

  #auth-checking {
    position: fixed; inset: 0; background: #fff; z-index: 999;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .15em; color: #aaa;
  }

  .mp-logo { color: #009ee3; font-weight: 700; }

  @media (max-width: 768px) {
    .pay-page { grid-template-columns: 1fr; height: auto; overflow: visible; }
    .pay-right { display: none; }
    .pay-left { border-right: none; height: calc(100vh - 56px - 48px); }
  }
</style>

<div id="auth-checking">CHECKING SESSION...</div>

<div class="pay-page">

  <div class="pay-left">

    <div style="flex-shrink:0;">
      <span class="auth-h-sign">COMPLETE</span>
      <span class="auth-h-create">YOUR</span>
      <span class="auth-h-account">PAYMENT</span>
    </div>

    <div class="pay-scroll">

      {status === 'success' && (
        <div class="pay-alert pay-alert-success">
          ✓ PAYMENT APPROVED — Your session is confirmed!
        </div>
      )}
      {status === 'failure' && (
        <div class="pay-alert pay-alert-failure">
          ✗ PAYMENT FAILED — Please try again.
        </div>
      )}
      {status === 'pending' && (
        <div class="pay-alert pay-alert-pending">
          ⏳ PAYMENT PENDING — We'll confirm once processed.
        </div>
      )}

      <div class="pay-summary" id="pay-summary">
        <div class="pay-summary-row">
          <span>RECIPE</span>
          <strong id="sum-recipe">—</strong>
        </div>
        <div class="pay-summary-row">
          <span>DATE</span>
          <strong id="sum-date">—</strong>
        </div>
        <div class="pay-summary-row">
          <span>TIME</span>
          <strong id="sum-time">—</strong>
        </div>
        <div class="pay-summary-row">
          <span>FORMAT</span>
          <strong>1:1 PRIVATE · ONLINE</strong>
        </div>
        <div class="pay-summary-row pay-summary-total">
          <span>TOTAL</span>
          <span class="pay-price" id="sum-price">$ —</span>
        </div>
      </div>

      <p style="font-family:'Space Mono',monospace;font-size:9px;color:#aaa;letter-spacing:.08em;line-height:1.8;margin-bottom:16px;">
        Secure payment via <span class="mp-logo">Mercado Pago</span>.<br/>
        You'll be redirected to complete the payment safely.
      </p>

    </div>

    <div class="pay-bottom">
      {status === 'success' ? (
        <a href="/session" style="display:flex;align-items:center;justify-content:center;gap:10px;padding:16px;background:#2d7a3a;color:#fff;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.15em;font-weight:700;text-decoration:none;">
          VIEW MY SESSION →
        </a>
      ) : (
        <>
          <button class="pay-btn" id="pay-btn" onclick="startPayment()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="4" width="22" height="16" rx="2"/><path d="M1 10h22"/>
            </svg>
            PAY WITH MERCADO PAGO
          </button>
          <a href="/session" class="pay-skip">
            SKIP PAYMENT — DEV MODE →
          </a>
        </>
      )}
      <button id="logout-btn" class="pay-logout">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
        SIGN OUT
      </button>
    </div>

  </div>

  <div class="pay-right">
    <div class="pay-cup">
      <img src="/images/cup.png" alt="Coffee cup" />
    </div>
    <div class="pay-watermark">05</div>
  </div>

</div>

</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) window.location.replace('/auth');
    else document.getElementById('auth-checking').style.display = 'none';
  });

  document.getElementById('logout-btn').addEventListener('click', async () => {
    await supabase.auth.signOut();
    localStorage.removeItem('pc_max_step');
    window.location.replace('/auth');
  });

  const booking = JSON.parse(localStorage.getItem('pc_booking') || '{}');

  if (booking.recipeName) document.getElementById('sum-recipe').textContent = booking.recipeName;
  if (booking.date) {
    const d = new Date(booking.date);
    document.getElementById('sum-date').textContent = d.toLocaleDateString('en-US', {
      weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
    });
  }
  if (booking.time) document.getElementById('sum-time').textContent = booking.time;

  async function loadPrice() {
    if (!booking.recipeId) return;
    const { data } = await supabase
      .from('recipes')
      .select('price')
      .eq('id', booking.recipeId)
      .single();
    if (data) {
      document.getElementById('sum-price').textContent = `$ ${data.price}`;
      booking.price = data.price;
    }
  }
  loadPrice();

  window.startPayment = async function() {
    const btn = document.getElementById('pay-btn');
    if (!btn) return;
    btn.textContent = 'REDIRECTING...';
    btn.disabled = true;

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { window.location.replace('/auth'); return; }

      const res = await fetch('/api/create-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          recipeName:  booking.recipeName || 'Coffee Session',
          price:       booking.price || 5,
          recipeId:    booking.recipeId || '',
          bookingDate: booking.date ? new Date(booking.date).toLocaleDateString() : '',
        }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Error creating payment');

      const url = data.initPoint;
      if (!url) throw new Error('No payment URL received');

      window.location.replace(url);

    } catch (err) {
      alert('Error: ' + err.message);
      if (btn) {
        btn.textContent = 'PAY WITH MERCADO PAGO';
        btn.disabled = false;
      }
    }
  };
</script>