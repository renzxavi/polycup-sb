---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase.js';

const supabase = createSupabaseServerClient(Astro.request, Astro.response);
const { data: recipes, error } = await supabase
  .from('recipes')
  .select('*')
  .eq('active', true)
  .order('created_at', { ascending: true });

const difficultyLabel = {
  easy:   { label: 'EASY',   color: '#2d7a3a' },
  medium: { label: 'MEDIUM', color: '#b87a00' },
  hard:   { label: 'HARD',   color: '#c94a35' },
};
---

<Layout title="Select Recipe" activeStep={2}>

<style>
  .pc-steps, .pc-steps-mobile { display: none !important; }

  .rp-page {
    display: grid;
    grid-template-columns: 38% 62%;
    height: calc(100vh - 56px);
    overflow: hidden;
  }

  .rp-left {
    display: flex;
    flex-direction: column;
    border-right: 2px solid #111;
    overflow: hidden;
  }

  .rp-list {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #e0ddd7 transparent;
  }
  .rp-list::-webkit-scrollbar { width: 4px; }
  .rp-list::-webkit-scrollbar-thumb { background: #e0ddd7; border-radius: 2px; }

  .rp-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid #e0ddd7;
    cursor: pointer;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: .1em;
    color: #aaa;
    background: #fff;
    transition: all .15s;
  }
  .rp-item:hover { background: #f5f5f5; color: #111; }
  .rp-item.selected { background: #e8c94a; border: 2px solid #111; color: #111; font-weight: 700; }
  .rp-item-num { font-size: 9px; font-weight: 700; flex-shrink: 0; width: 20px; }
  .rp-item-name { flex: 1; font-size: 10px; }
  .rp-item-diff { font-size: 9px; font-weight: 700; letter-spacing: .1em; flex-shrink: 0; }

  .rp-bottom { flex-shrink: 0; display: flex; flex-direction: column; border-top: 2px solid #111; }

  .rp-select-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 14px 16px; background: #e8c94a; border: none;
    font-family: 'Space Mono', monospace; font-size: 11px;
    letter-spacing: .15em; font-weight: 700; text-decoration: none; color: #111;
    transition: background .15s; opacity: .4; pointer-events: none;
  }
  .rp-select-btn.ready { opacity: 1; pointer-events: all; }
  .rp-select-btn.ready:hover { background: #d4b535; }

  .rp-logout {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: .12em;
    background: none; border: none; border-top: 1px solid #e0ddd7;
    color: #c94a35; cursor: pointer; width: 100%; text-align: left;
  }
  .rp-logout:hover { background: #fff0ee; }

  .rp-right {
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }

  .rp-cup { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); }
  .rp-cup img { width: clamp(280px, 30vw, 460px); height: auto; object-fit: contain; }

  .rp-step-num-bg {
    position: absolute; bottom: 80px; right: 40px;
    font-family: 'Black Han Sans', sans-serif; font-size: 160px;
    color: #f0f0f0; line-height: 1; user-select: none; pointer-events: none;
  }

  #auth-checking {
    position: fixed; inset: 0; background: #fff; z-index: 999;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .15em; color: #aaa;
  }

  @media (max-width: 768px) {
    .rp-page { grid-template-columns: 1fr; height: auto; overflow: visible; }
    .rp-right { display: none; }
    .rp-left { border-right: none; height: calc(100vh - 56px - 48px); }
  }
</style>

<div id="auth-checking">CHECKING SESSION...</div>

<div class="rp-page">

  <div class="rp-left">
    <div style="flex-shrink:0;">
      <span class="auth-h-sign">SELECT</span>
      <span class="auth-h-create">YOUR COFFEE</span>
      <span class="auth-h-account">RECIPE</span>
    </div>

    <div class="rp-list">
      {recipes?.map((recipe, i) => (
        <div class="rp-item" data-id={recipe.id} onclick="selectRecipe(this)">
          <span class="rp-item-num">0{i + 1}</span>
          <span class="rp-item-name">{recipe.name}</span>
          <span class="rp-item-diff" style={`color:${difficultyLabel[recipe.difficulty]?.color ?? '#888'}`}>
            {difficultyLabel[recipe.difficulty]?.label ?? recipe.difficulty}
          </span>
        </div>
      ))}
    </div>

    <div class="rp-bottom">
      <a id="rp-select-btn" href="#" class="rp-select-btn">SELECT THIS RECIPE →</a>
      <button id="logout-btn" class="rp-logout">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
        SIGN OUT
      </button>
    </div>
  </div>

  <div class="rp-right">
    <div class="rp-cup">
      <img src="/images/cup.png" alt="Coffee cup" />
    </div>
    <div class="rp-step-num-bg">02</div>
  </div>

</div>

</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) window.location.replace('/auth');
    else document.getElementById('auth-checking').style.display = 'none';
  });

  document.getElementById('logout-btn').addEventListener('click', async () => {
    await supabase.auth.signOut();
    localStorage.removeItem('pc_max_step');
    window.location.replace('/auth');
  });

  window.selectRecipe = function(el) {
    document.querySelectorAll('.rp-item').forEach(i => i.classList.remove('selected'));
    el.classList.add('selected');
    const btn = document.getElementById('rp-select-btn');
    btn.href = `/schedule?recipe=${el.dataset.id}`;
    btn.classList.add('ready');
  };
</script>