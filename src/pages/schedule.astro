---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase.js';

const supabase = createSupabaseServerClient(Astro.request, Astro.response);
const recipeId = Astro.url.searchParams.get('recipe') || '';
let recipe = null;

if (recipeId) {
  const { data } = await supabase.from('recipes').select('*').eq('id', recipeId).single();
  recipe = data;
}

const timeSlots = ['09:00', '10:00', '11:00', '14:00', '15:00', '16:00', '17:00'];
---

<Layout title="Choose Date & Time" activeStep={3}>

<style>
  .pc-steps, .pc-steps-mobile { display: none !important; }

  .sc-page {
    display: grid;
    grid-template-columns: 38% 62%;
    height: calc(100vh - 56px);
    overflow: hidden;
  }

  .sc-left {
    display: flex;
    flex-direction: column;
    border-right: 2px solid #111;
    overflow: hidden;
  }

  .sc-scroll {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #e0ddd7 transparent;
    padding: 16px 20px;
  }
  .sc-scroll::-webkit-scrollbar { width: 4px; }
  .sc-scroll::-webkit-scrollbar-thumb { background: #e0ddd7; border-radius: 2px; }

  .sc-recipe-info {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: #f9f9f9;
    border: 1px solid #e0ddd7;
    margin-bottom: 16px;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: #555;
    letter-spacing: .05em;
  }
  .sc-recipe-info strong {
    font-family: 'Black Han Sans', sans-serif;
    font-size: 12px;
    color: #111;
  }

  .sc-cal-header {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;
  }
  .sc-cal-title { font-family: 'Black Han Sans', sans-serif; font-size: 13px; letter-spacing: .05em; }
  .sc-cal-nav { display: flex; gap: 4px; }
  .sc-cal-btn {
    width: 26px; height: 26px; border: 1px solid #e0ddd7; background: #fff;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    font-size: 12px; transition: background .15s;
  }
  .sc-cal-btn:hover { background: #f0f0f0; }

  .sc-cal-grid {
    display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-bottom: 4px;
  }
  .sc-cal-day-name {
    font-family: 'Space Mono', monospace; font-size: 8px; color: #aaa;
    text-align: center; padding: 3px 0; letter-spacing: .05em;
  }

  .sc-time-label {
    font-family: 'Space Mono', monospace; font-size: 9px;
    letter-spacing: .15em; color: #8a8a8a; margin-bottom: 8px; margin-top: 14px;
  }
  .sc-time-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
  .sc-time-slot {
    padding: 7px 4px; text-align: center; font-family: 'Space Mono', monospace;
    font-size: 10px; border: 1px solid #e0ddd7; cursor: pointer; background: #fff; transition: all .15s;
  }
  .sc-time-slot:hover { border-color: #111; background: #f5f5f5; }
  .sc-time-slot.selected { background: #111; color: #e8c94a; border-color: #111; font-weight: 700; }

  .sc-bottom { flex-shrink: 0; display: flex; flex-direction: column; border-top: 2px solid #111; }

  .sc-confirm-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 14px 16px; background: #e8c94a; border: none;
    font-family: 'Space Mono', monospace; font-size: 11px;
    letter-spacing: .15em; font-weight: 700; color: #111;
    transition: background .15s; opacity: .4; pointer-events: none; cursor: not-allowed;
  }
  .sc-confirm-btn.ready { opacity: 1; pointer-events: all; cursor: pointer; }
  .sc-confirm-btn.ready:hover { background: #d4b535; }

  .sc-logout {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: .12em;
    background: none; border: none; border-top: 1px solid #e0ddd7;
    color: #c94a35; cursor: pointer; width: 100%; text-align: left;
  }
  .sc-logout:hover { background: #fff0ee; }

  .sc-right {
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }

  .sc-cup { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); }
  .sc-cup img { width: clamp(280px, 30vw, 460px); height: auto; object-fit: contain; }

  .sc-watermark {
    position: absolute; bottom: 80px; right: 40px;
    font-family: 'Black Han Sans', sans-serif; font-size: 160px;
    color: #f0f0f0; line-height: 1; user-select: none; pointer-events: none;
  }

  #auth-checking {
    position: fixed; inset: 0; background: #fff; z-index: 999;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .15em; color: #aaa;
  }

  @media (max-width: 768px) {
    .sc-page { grid-template-columns: 1fr; height: auto; overflow: visible; }
    .sc-right { display: none; }
    .sc-left { border-right: none; }
  }
</style>

<div id="auth-checking">CHECKING SESSION...</div>

<div class="sc-page">

  <!-- LEFT -->
  <div class="sc-left">

    <div style="flex-shrink:0;">
      <span class="auth-h-sign">CHOOSE</span>
      <span class="auth-h-create">DATE &</span>
      <span class="auth-h-account">TIME</span>
    </div>

    <div class="sc-scroll">

      {recipe ? (
        <div class="sc-recipe-info">
          <strong>{recipe.name}</strong>
          · {recipe.duration} min · ${recipe.price}
        </div>
      ) : (
        <div class="sc-recipe-info">
          <strong>No recipe selected</strong>
          <a href="/recipes" style="color:#5a7a9f;font-size:10px;">← recipes</a>
        </div>
      )}

      <div class="sc-cal-header">
        <span class="sc-cal-title" id="cal-title"></span>
        <div class="sc-cal-nav">
          <button class="sc-cal-btn" onclick="prevMonth()">‹</button>
          <button class="sc-cal-btn" onclick="nextMonth()">›</button>
        </div>
      </div>

      <div class="sc-cal-grid" id="cal-grid">
        {['SUN','MON','TUE','WED','THU','FRI','SAT'].map(d => (
          <div class="sc-cal-day-name">{d}</div>
        ))}
      </div>

      <div id="time-section" style="display:none">
        <div class="sc-time-label">SELECT A TIME SLOT</div>
        <div class="sc-time-grid">
          {timeSlots.map(t => (
            <div class="sc-time-slot" data-time={t} onclick="selectTime(this)">{t}</div>
          ))}
        </div>
      </div>

    </div>

    <div class="sc-bottom">
      <button class="sc-confirm-btn" id="confirm-btn" onclick="confirmBooking()">
        CONFIRM DATE & TIME →
      </button>
      <button id="logout-btn" class="sc-logout">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
        SIGN OUT
      </button>
    </div>

  </div>

  <!-- RIGHT -->
  <div class="sc-right">
    <div class="sc-cup">
      <img src="/images/cup.png" alt="Coffee cup" />
    </div>
    <div class="sc-watermark">03</div>
  </div>

</div>

</Layout>

<script define:vars={{ recipeId, recipeName: recipe?.name ?? '', recipeDuration: recipe?.duration ?? 60, recipePrice: recipe?.price ?? 5 }}>
  window.__RECIPE__ = { recipeId, recipeName, recipeDuration, recipePrice };
</script>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const { recipeName, recipeDuration, recipePrice } = window.__RECIPE__ || {};
  const recipeIdParam = new URLSearchParams(window.location.search).get('recipe') || '';

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) window.location.replace('/auth');
    else document.getElementById('auth-checking').style.display = 'none';
  });
  setTimeout(() => { const el = document.getElementById('auth-checking'); if (el) el.style.display = 'none'; }, 3000);

  document.getElementById('logout-btn').addEventListener('click', async () => {
    await supabase.auth.signOut();
    localStorage.removeItem('pc_max_step');
    window.location.replace('/auth');
  });

  const today   = new Date();
  const minDate = new Date(today);
  minDate.setDate(today.getDate() + 7);

  let currentYear  = minDate.getFullYear();
  let currentMonth = minDate.getMonth();
  let selectedDate = null;
  let selectedTime = null;

  const months = ['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE','JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];

  function renderCalendar() {
    document.getElementById('cal-title').textContent = `${months[currentMonth]} ${currentYear}`;

    let days = document.getElementById('cal-days');
    if (!days) {
      days = document.createElement('div');
      days.id = 'cal-days';
      days.style.cssText = 'display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:12px;';
      document.getElementById('cal-grid').after(days);
    }
    days.innerHTML = '';

    const firstDay    = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

    for (let i = 0; i < firstDay; i++) days.appendChild(document.createElement('div'));

    for (let d = 1; d <= daysInMonth; d++) {
      const dayDate = new Date(currentYear, currentMonth, d);
      const div     = document.createElement('div');
      div.textContent = d;

      const disabled   = dayDate < minDate;
      const isSelected = selectedDate && dayDate.toDateString() === selectedDate.toDateString();

      div.style.cssText = `
        aspect-ratio:1;display:flex;align-items:center;justify-content:center;
        font-family:'Space Mono',monospace;font-size:11px;
        border:2px solid transparent;transition:all .15s;
        ${disabled  ? 'color:#ddd;cursor:not-allowed;' : 'cursor:pointer;'}
        ${isSelected ? 'background:#111;color:#e8c94a;border-color:#111;font-weight:700;' : ''}
      `;

      if (!disabled) {
        div.addEventListener('mouseover', () => { if (!isSelected) div.style.background = '#f0f0f0'; });
        div.addEventListener('mouseout',  () => { if (!isSelected) div.style.background = ''; });
        div.addEventListener('click',     () => pickDate(dayDate, div));
      }
      days.appendChild(div);
    }
  }

  window.prevMonth = function() {
    if (currentMonth === 0) { currentMonth = 11; currentYear--; } else currentMonth--;
    renderCalendar();
  };
  window.nextMonth = function() {
    if (currentMonth === 11) { currentMonth = 0; currentYear++; } else currentMonth++;
    renderCalendar();
  };

  function pickDate(date, el) {
    selectedDate = date;
    selectedTime = null;
    document.querySelectorAll('#cal-days > div').forEach(d => {
      d.style.background = ''; d.style.color = ''; d.style.borderColor = 'transparent'; d.style.fontWeight = '';
    });
    if (el) {
      el.style.background = '#111'; el.style.color = '#e8c94a';
      el.style.borderColor = '#111'; el.style.fontWeight = '700';
    }
    document.querySelectorAll('.sc-time-slot').forEach(s => s.classList.remove('selected'));
    document.getElementById('time-section').style.display = 'block';
    document.getElementById('confirm-btn').classList.remove('ready');
  }

  window.selectTime = function(el) {
    document.querySelectorAll('.sc-time-slot').forEach(s => s.classList.remove('selected'));
    el.classList.add('selected');
    selectedTime = el.dataset.time;
    document.getElementById('confirm-btn').classList.add('ready');
  };

  window.confirmBooking = async function() {
    if (!selectedDate || !selectedTime) return;

    const btn = document.getElementById('confirm-btn');
    btn.textContent = 'CREATING MEET...';
    btn.classList.remove('ready');

    const [h, m] = selectedTime.split(':').map(Number);
    const start  = new Date(selectedDate);
    start.setHours(h, m, 0, 0);
    const end = new Date(start);
    end.setMinutes(end.getMinutes() + (recipeDuration || 60));

    // Obtener provider_token de Google
    const { data: { session } } = await supabase.auth.getSession();
    const googleToken = session?.provider_token;

    // DEBUG — mirá esto en F12 → Console
    console.log('Google token:', googleToken ? 'OK ✓' : 'VACÍO ✗');
    console.log('Session:', session ? 'OK ✓' : 'NO HAY SESIÓN ✗');

    let meetLink      = '';
    let gcalEventLink = '';

    if (googleToken) {
      try {
        const res = await fetch('/api/create-meeting', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title:       'PolyCup: ' + (recipeName || 'Coffee Session'),
            start:       start.toISOString(),
            end:         end.toISOString(),
            googleToken,
          }),
        });
        const result = await res.json();

        // DEBUG
        console.log('STATUS:', res.status);
        console.log('RESULT:', JSON.stringify(result));

        meetLink      = result.meetLink  || '';
        gcalEventLink = result.gcalLink  || '';
      } catch (e) {
        console.error('Error creating meeting:', e);
      }
    } else {
      console.warn('Sin provider_token — el usuario no se logueó con Google o el token expiró');
    }

    // Fallback si falló
    if (!meetLink) {
      console.warn('meetLink vacío, usando fallback');
      const code = Math.random().toString(36).substring(2,5) + '-' +
                   Math.random().toString(36).substring(2,5) + '-' +
                   Math.random().toString(36).substring(2,5);
      meetLink = `https://meet.google.com/${code}`;
    }

    btn.textContent = 'SAVING...';

    const fmt = d => d.toISOString().replace(/[-:]/g,'').split('.')[0] + 'Z';
    const gcalUrl = gcalEventLink || (
      `https://calendar.google.com/calendar/render?action=TEMPLATE` +
      `&text=${encodeURIComponent('PolyCup: ' + (recipeName || 'Coffee Session'))}` +
      `&dates=${fmt(start)}/${fmt(end)}` +
      `&details=${encodeURIComponent('PolyCup 1:1 coffee class.\nJoin: ' + meetLink)}` +
      `&location=${encodeURIComponent('Google Meet')}`
    );

    if (session) {
      const { data: sessionData } = await supabase
        .from('sessions')
        .insert({
          recipe_id:   window.__RECIPE__.recipeId || null,
          starts_at:   start.toISOString(),
          duration:    recipeDuration || 60,
          max_spots:   1,
          spots_taken: 1,
          meet_link:   meetLink,
          active:      true,
        })
        .select()
        .single();

      if (sessionData) {
        await supabase.from('bookings').insert({
          user_id:    session.user.id,
          session_id: sessionData.id,
          status:     'confirmed',
          notes:      `Recipe: ${recipeName} | Time: ${selectedTime}`,
        });
      }
    }

    localStorage.setItem('pc_booking', JSON.stringify({
      date:       selectedDate.toISOString(),
      time:       selectedTime,
      meetLink,
      gcalUrl,
      recipeName: recipeName || 'Coffee Session',
      recipeId:   window.__RECIPE__?.recipeId || recipeIdParam || '',
    }));

    window.location.href = `/prepare?recipe=${window.__RECIPE__?.recipeId || recipeIdParam || ''}`;
  };

  document.addEventListener('DOMContentLoaded', () => { renderCalendar(); });
</script>